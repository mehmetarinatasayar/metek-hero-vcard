# Yerel yonetim uygulamasi. Calisan .env dosyanizi bununla degistirmeyin.
EXPO_PUBLIC_API_URL=http://localhost:3001
PUBLIC_BASE_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_PATH=./data/metek.sqlite
TRUST_PROXY=0

# Internetten QR acilisi icin kart servisi ayarlari (yalnizca sunucu).
# PUBLIC_BASE_URL=https://metek-hero-vcard.arinatasayar.chatgpt.site
# REMOTE_CARDS_URL=https://metek-hero-vcard.arinatasayar.chatgpt.site
# REMOTE_CARDS_KEY=Sites-METEK_SERVICE_KEY-ile-ayni-gizli-deger
# Mevcut kayitlari ilk kez aktarmak icin: node --import tsx server/migrateRemoteCards.ts
# Anahtari EXPO_PUBLIC degiskeni yapmayin veya kaynak paketine eklemeyin.
# Expo Go: npm.cmd run go. Gelistirme API adresi Expo baglantisindan otomatik bulunur.
# Telefona EXPO_PUBLIC_API_URL olarak localhost gonderildiginde gelistirmede Expo yonlendirmesi kullanilir.
